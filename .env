# ===== Application =====
APP_NAME=recruitmentService
BUILD_VERSION=1.0.0
APP_VERSION=0.0.1-SNAPSHOT
APP_ENVIRONMENT=development

# ===== Spring Profiles =====
SPRING_PROFILES_ACTIVE=dev

# ===== Server =====
SERVER_PORT=8082
SERVER_COMPRESSION_ENABLED=true
JAVA_OPTS=-Xms256m -Xmx512m

# ===== PostgreSQL Container =====
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_PORT=5432
POSTGRES_DB=recruitment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=M@ngo0710

# ===== Spring DataSource =====
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/recruitment_db
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/recruitment_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=M@ngo0710

# ===== Hikari Pool =====
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=20000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=300000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000
SPRING_DATASOURCE_HIKARI_LEAK_DETECTION_THRESHOLD=60000

# ===== Redis =====
# For app in Docker: use service name 'redis'
SPRING_DATA_REDIS_HOST=redis
# For local run: use 'localhost'
# SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_TIMEOUT=2s
SPRING_DATA_REDIS_LETTUCE_POOL_MAX_ACTIVE=8
SPRING_DATA_REDIS_LETTUCE_POOL_MAX_IDLE=8
SPRING_DATA_REDIS_LETTUCE_POOL_MIN_IDLE=0

# ===== Cache (ADDED) =====
SPRING_CACHE_TYPE=redis
SPRING_CACHE_REDIS_TIME_TO_LIVE=3600000

# ===== JPA/Hibernate =====
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_PROPERTIES_HIBERNATE_JDBC_BATCH_SIZE=20
SPRING_JPA_PROPERTIES_HIBERNATE_ORDER_INSERTS=true
SPRING_JPA_PROPERTIES_HIBERNATE_ORDER_UPDATES=true

# ===== Flyway =====
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_FLYWAY_CLEAN_DISABLED=true

# ===== DevTools Hot Reload =====
SPRING_DEVTOOLS_RESTART_ENABLED=true
SPRING_DEVTOOLS_LIVERELOAD_ENABLED=true
SPRING_DEVTOOLS_RESTART_POLL_INTERVAL=2s
SPRING_DEVTOOLS_RESTART_QUIET_PERIOD=1000ms
SPRING_DEVTOOLS_RESTART_ADDITIONAL_PATHS=src/main
SPRING_DEVTOOLS_LIVERELOAD_PORT=35729

# ===== Actuator =====
MANAGEMENT_ENDPOINTS_ENABLED_BY_DEFAULT=true
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINTS_WEB_BASE_PATH=/actuator
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
MANAGEMENT_ENDPOINT_HEALTH_GROUP_READINESS_INCLUDE=db,redis
MANAGEMENT_ENDPOINT_HEALTH_GROUP_LIVENESS_INCLUDE=ping
MANAGEMENT_METRICS_EXPORT_SIMPLE_ENABLED=true

# ===== Logging =====
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=DEBUG
LOGGING_LEVEL_ORG_HIBERNATE_SQL=INFO
LOGGING_LEVEL_COM_CVSERVICE=DEBUG

# ===== App Features =====
APP_FEATURES_CACHE_ENABLED=true
APP_FEATURES_METRICS_ENABLED=true

# Application URLs
FRONTEND_URL=http://localhost:3000
LOGO_URL=https://yourapp.com/logo.png

# Support Emails
SUPPORT_EMAIL=support@oneclick.com
SECURITY_EMAIL=security@oneclick.com